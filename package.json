{
  "name": "novamart-ecommerce-platform",
  "version": "1.0.0",
  "description": "NovaMart - Enterprise B2C E-Commerce Web Application (Customer Storefront, Admin Portal, Delivery Partner Portal, Spring Boot REST API)",
  "scripts": {
    "start": "start-all.bat",
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"cyan.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:all": "start-all.bat",
    "dev:windows": "start-all.bat",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && mvn spring-boot:run",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && mvn test-compile",
    "build": "npm run build:frontend && npm run build:backend",
    "clean:build": "scripts\\clean-build.bat",
    "backup": "node scripts/backup-db.js && node scripts/backup-code.js",
    "backup:db": "node scripts/backup-db.js",
    "restore:db": "node scripts/restore-db.js",
    "backup:code": "node scripts/backup-code.js",
    "backup:watch": "node scripts/auto-backup-watcher.js",
    "dev:with-backup": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND,BACKUP\" -c \"cyan.bold,magenta.bold,yellow.bold\" \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run backup:watch\""
  },
  "keywords": [
    "ecommerce",
    "b2c",
    "spring-boot",
    "react",
    "vite",
    "area-based-delivery",
    "jwt",
    "customer-storefront",
    "admin-portal",
    "delivery-partner"
  ],
  "author": "NovaMart Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
