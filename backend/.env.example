# NovaMart Backend Environment Configuration
# Server Port
PORT=8080

# Spring Profiles: dev (H2/MySQL), prod (MySQL)
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/ecommerce_db?createDatabaseIfNotExist=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password

# JWT Security Configuration (HMAC-SHA256, minimum 256 bits)
JWT_SECRET=your_base64_encoded_secret_key_minimum_256_bits_length_here
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173
