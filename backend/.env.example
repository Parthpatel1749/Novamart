# NovaMart Backend Scalability & Production Environment Configuration

# Server & Threading (Port & Loom Virtual Threads)
PORT=8080
SPRING_THREADS_VIRTUAL_ENABLED=true

# Spring Profiles: dev (H2/MySQL), prod (MySQL)
SPRING_PROFILES_ACTIVE=prod

# High-Performance MySQL Configuration
DB_URL=jdbc:mysql://localhost:3306/ecommerce_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true&cachePrepStmts=true&prepStmtCacheSize=250&prepStmtCacheSqlLimit=2048
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password

# HikariCP Connection Pool (Scaled for High Concurrency)
HIKARI_MAX_POOL_SIZE=60
HIKARI_MIN_IDLE=20
HIKARI_CONNECTION_TIMEOUT=20000

# JWT Security Configuration (HMAC-SHA256, minimum 256 bits)
JWT_SECRET=your_base64_encoded_secret_key_minimum_256_bits_length_here
JWT_EXPIRATION_MS=86400000

# High-Throughput Token Bucket Rate Limiting
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_GENERAL_CAPACITY=300
APP_RATE_LIMIT_GENERAL_REFILL_TOKENS=300
APP_RATE_LIMIT_AUTH_CAPACITY=5
APP_RATE_LIMIT_AUTH_REFILL_TOKENS=5

# CORS Allowed Origins (Comma-separated for production frontend domain)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://novamart.example.com

# Google Identity Services / OpenID Connect OAuth 2.0 Client ID (Audience)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

